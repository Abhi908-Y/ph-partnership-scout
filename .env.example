# Product Hunt: create an app at https://www.producthunt.com/v2/oauth/applications and copy the "Developer token"
PRODUCTHUNT_TOKEN=

# Gemini Flash via OpenRouter (the only AI gateway): https://openrouter.ai/keys
# Every request is pinned to Google's own infrastructure; only google/ Gemini Flash models are allowed.
OPENROUTER_API_KEY=
GEMINI_MODEL=google/gemini-3.7-flash

# Neon Postgres connection string (Vercel's Neon integration sets DATABASE_URL automatically)
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Telegram: create a bot with @BotFather, send it a message, then read chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Public URL of the deployed app (used in Telegram messages)
APP_URL=https://your-app.vercel.app

# Shared secret for the GitHub Actions scheduler (any long random string)
CRON_SECRET=

# Optional overrides
# MY_PRODUCT_DESCRIPTION=...
# PH_TOPICS=task-management,productivity,human-resources,hiring,developer-tools,software-engineering,meetings,messaging,remote-work

# --- Founder outreach (optional) ---
# Founder LinkedIn/email lookup uses Gemini + web search through OPENROUTER_API_KEY (about $0.007 per founder).
# Resend sends emails from the dashboard: https://resend.com/api-keys
RESEND_API_KEY=
# Test mode: every email goes to this address instead of the founder (use your own Resend account email).
OUTREACH_TEST_TO=
# Sender. Leave empty to use Resend's test sender (onboarding@resend.dev), which only delivers to your own address.
# For real sending, verify a domain in Resend and set e.g. OUTREACH_FROM=Kavya <kavya@yourcompany.com>
OUTREACH_FROM=
# OUTREACH_REPLY_TO=kavya@yourcompany.com
# Used in Gemini-written emails and LinkedIn notes
OUTREACH_SENDER_NAME=Kavya
# MY_COMPANY_NAME=
